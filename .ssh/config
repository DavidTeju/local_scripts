# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Host *
    UseKeychain yes
    AddKeysToAgent yes

# UndocuStudent VPS
Host projects
    HostName 82.29.152.139
    User tejuosho
    IdentityFile ~/.ssh/id_ed25519

# Escape hatch — root login via key only
Host projects-root
    HostName 82.29.152.139
    User root
    IdentityFile ~/.ssh/id_ed25519

# Openclaw VPS (Tailscale only - public SSH firewalled)
Host openclaw
    HostName 100.73.19.15
    User root
    IdentityFile ~/.ssh/id_openclaw
